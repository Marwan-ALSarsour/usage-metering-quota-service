# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (PostgreSQL running via Docker Compose)
# Note: Host port 5433 maps to container port 5432 to avoid conflict with local postgres on 5432
DB_HOST=localhost
DB_PORT=5433
DB_USER=metering_user
DB_PASSWORD=metering_pass
DB_NAME=usage_metering
DATABASE_URL=postgres://metering_user:metering_pass@localhost:5433/usage_metering

# Admin Secret Key for creating accounts and administrative tasks
ADMIN_API_KEY=admin_dev_secret_key_123
